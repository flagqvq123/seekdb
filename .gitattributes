.gitattributes export-ignore
.gitignore export-ignore

# All OceanBase code is auto-formatted using clang-format.
*.c filter=codeformat
*.cc filter=codeformat
*.cpp filter=codeformat
*.h filter=codeformat
*.hpp filter=codeformat
*.i filter=codeformat
*.ic filter=codeformat
*.js filter=codeformat
# Round-2 additions: keep Linux-facing scripts LF even when checked out on Windows.
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
